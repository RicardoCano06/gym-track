# Copiar a .env.local
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Solo para el script de seed (NUNCA exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Password del usuario de test E2E (NUNCA hardcodear; rotar si se filtró)
E2E_TEST_PASSWORD=tu-password-rotada
# Password de la cuenta demo (opcional, por despliegue). Sin valor, el botón
# demo usa el modo 100% local sin tocar Supabase.
VITE_DEMO_PASSWORD=
