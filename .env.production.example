# Variables de producción — NO versionar valores reales.
#
# Este archivo es solo una guía. En Cloudflare Pages las variables se definen
# en el dashboard (Settings > Environment variables) para producción y preview,
# y Vite las inyecta en el build automáticamente. No hace falta este archivo
# en el repo para desplegar; se mantiene como referencia.
#
# La URL y la ANON key son públicas por diseño (viajan en el bundle del
# frontend); aún así se gestionan por entorno y NUNCA se versionan.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: password de la cuenta demo online. Sin valor, el botón "Demo" usa
# el modo 100% local (sin tocar Supabase). Configurarla aquí o en Cloudflare.
VITE_DEMO_PASSWORD=
